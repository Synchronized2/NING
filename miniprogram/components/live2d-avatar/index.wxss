:host {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-root,
.avatar-canvas {
  width: 100%;
  height: 100%;
}

.avatar-root {
  position: relative;
  overflow: hidden;
}

.avatar-canvas {
  display: block;
}

.view-toggle {
  position: absolute;
  z-index: 3;
  right: 20rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 2rpx 10rpx rgba(37, 42, 45, 0.12);
}

.view-toggle::after {
  border: 0;
}

.view-toggle image {
  width: 34rpx;
  height: 34rpx;
}

.avatar-status {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #687078;
  font-size: 23rpx;
  pointer-events: none;
}

.avatar-status.error {
  flex-direction: column;
  color: #855249;
  pointer-events: auto;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #17a673;
  animation: status-pulse 1.1s ease-in-out infinite;
}

.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 48rpx;
  margin: 6rpx 0 0;
  padding: 0;
  border-radius: 6rpx;
  background: #eef1f3;
  color: #4f565e;
  font-size: 21rpx;
  line-height: normal;
}

.retry-button::after {
  border: 0;
}

@keyframes status-pulse {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
