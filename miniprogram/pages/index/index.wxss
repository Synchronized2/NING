.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f7f8fa;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 24rpx 0 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6e8eb;
  box-sizing: border-box;
}

.identity,
.topbar-actions,
.message-footer,
.message-actions {
  display: flex;
  align-items: center;
}

.identity {
  flex: 1 1 auto;
  min-width: 0;
}

.topbar-actions {
  flex: none;
  gap: 8rpx;
  margin-left: 12rpx;
}

.topbar .top-icon {
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
}

.topbar .top-icon image {
  width: 45rpx;
  height: 45rpx;
}

.topbar .top-icon.active {
  background: transparent;
}

.brand-mark,
.empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  background: #17191c;
  color: #ffffff;
  font-weight: 700;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
}

.identity-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.brand {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 650;
}

.model-name {
  max-width: 310rpx;
  overflow: hidden;
  color: #777d85;
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.image-controls {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 8rpx 20rpx;
  overflow: hidden;
  background: #ffffff;
  border-bottom: 1rpx solid #e6e8eb;
  box-sizing: border-box;
}

.control-chip,
.template-chip {
  height: 44rpx;
  border-radius: 6rpx;
  background: #eef1f3;
  color: #4f565e;
  font-size: 20rpx;
  line-height: 44rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.control-chip {
  padding: 0 12rpx;
}

.template-scroll {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
}

.template-row {
  display: inline-flex;
  gap: 8rpx;
}

.template-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  margin: 0;
  padding: 0;
}

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  flex: 0 0 auto;
  padding: 14rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e6e8eb;
}

.mode-option {
  height: 64rpx;
  color: #666d75;
  font-size: 27rpx;
  line-height: 64rpx;
  text-align: center;
  border-bottom: 4rpx solid transparent;
  box-sizing: border-box;
}

.mode-option.active {
  color: #17191c;
  border-bottom-color: #17a673;
  font-weight: 600;
}

.conversation {
  flex: 1 1 auto;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-height: 100%;
  padding: 40rpx 60rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-symbol {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 32rpx;
  border-radius: 12rpx;
  font-size: 42rpx;
}

.empty-title {
  display: block;
  width: 100%;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 48rpx;
  text-align: center;
}

.empty-copy {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  color: #737981;
  font-size: 27rpx;
  line-height: 42rpx;
  text-align: center;
}

.primary-button {
  height: 84rpx;
  border-radius: 8rpx;
  background: #17191c;
  color: #ffffff;
  font-size: 29rpx;
  line-height: 84rpx;
}

.primary-button.compact {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  margin-top: 32rpx;
  padding: 0;
  line-height: normal;
}

.message-row {
  padding: 32rpx 30rpx 34rpx;
  border-bottom: 1rpx solid #e8eaed;
}

.message-row.assistant {
  background: #ffffff;
}

.message-row.user {
  background: #f7f8fa;
}

.message-label {
  margin-bottom: 14rpx;
  color: #555c64;
  font-size: 24rpx;
  font-weight: 650;
}

.message-content {
  overflow-wrap: anywhere;
  color: #22262a;
  font-size: 30rpx;
  line-height: 1.75;
}

.message-content.error {
  color: #a53f34;
}

.loading-line {
  display: flex;
  align-items: center;
  height: 52rpx;
  color: #777d85;
  font-size: 26rpx;
}

.loading-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #17a673;
  animation: pulse 1.1s infinite ease-in-out;
}

.loading-dot:nth-child(2) { animation-delay: 0.15s; }
.loading-dot:nth-child(3) { margin-right: 16rpx; animation-delay: 0.3s; }

@keyframes pulse {
  0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.generated-image {
  display: block;
  width: 100%;
  max-width: 640rpx;
  min-height: 320rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #eef0f2;
}

.attached-image {
  display: block;
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 14rpx;
  border-radius: 8rpx;
  background: #eef0f2;
}

.image-prompt {
  display: block;
  margin-top: 18rpx;
  color: #656c74;
  font-size: 25rpx;
  line-height: 40rpx;
}

.message-footer {
  justify-content: space-between;
  align-items: flex-end;
  gap: 12rpx;
  min-height: 50rpx;
  margin-top: 18rpx;
}

.message-actions {
  flex: none;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta {
  color: #91969d;
  font-size: 21rpx;
}

.mini-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  height: 40rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: #eef1f3;
  color: #50575f;
  font-size: 20rpx;
  line-height: 40rpx;
  box-sizing: border-box;
}

.mini-action.copy-action {
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
}

.mini-action.save-action {
  width: 124rpx;
  min-width: 124rpx;
  max-width: 124rpx;
}

.page-bottom {
  height: 20rpx;
}

.composer-wrap {
  flex: 0 0 auto;
  padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e1e4e7;
}

.attachment-preview {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 10rpx;
}

.attachment-preview image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 7rpx;
  background: #eef0f2;
}

.remove-attachment {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  background: #17191c;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 48rpx;
}

.composer-status {
  margin-bottom: 10rpx;
  color: #177b5c;
  font-size: 21rpx;
  line-height: 30rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  min-height: 78rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  border: 2rpx solid #d5d9dd;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.message-input {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 56rpx;
  max-height: 220rpx;
  padding: 6rpx 10rpx 6rpx 0;
  color: #17191c;
  font-size: 29rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}

.composer-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 64rpx;
  margin: 0 6rpx 0 0;
  padding: 0;
  border-radius: 6rpx;
  background: transparent;
  box-sizing: border-box;
}

.composer-tool image {
  width: 42rpx;
  height: 42rpx;
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 7rpx;
  background: #dfe3e6;
  box-sizing: border-box;
}

.send-button.ready {
  background: #17a673;
}

.send-button.stop-button {
  background: #17191c;
}

.send-button image {
  width: 42rpx;
  height: 42rpx;
}

.domain-hint {
  display: block;
  margin-top: 12rpx;
  color: #888e95;
  font-size: 21rpx;
  line-height: 32rpx;
  text-align: center;
}
